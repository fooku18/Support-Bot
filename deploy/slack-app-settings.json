{
  "display_information": {
    "name": "Support Agent"
  },
  "features": {
    "bot_user": {
      "display_name": "support-agent",
      "always_online": true
    },
    "agent_view": {
      "suggested_prompts": []
    }
  },
  "oauth_config": {
    "redirect_urls": ["https://ADMIN_HOST/slack/oauth/callback"],
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "groups:history",
        "chat:write",
        "files:read",
        "files:write",
        "reactions:write",
        "users:read",
        "channels:read",
        "groups:read",
        "users:read.email",
        "assistant:write",
        "search:read.public"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["app_mention", "message.channels", "message.groups"]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
