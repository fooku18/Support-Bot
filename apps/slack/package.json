{
  "name": "@support-agent/slack",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Authenticated Slack transport for the native Mastra application.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node scripts/build.mjs",
