    "undici": "8.14.0"
  },
  "devDependencies": {
    "@types/node": "26.6.11",
    "@types/ws": "8.18.2",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.1.2",
    "ws": "8.23.1",
    "esbuild": "0.28.2"
  }
