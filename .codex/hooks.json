{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "project_root=\"$(git rev-parse --show-toplevel)\" && CLAUDE_PROJECT_DIR=\"$project_root\" node \"$project_root/.agents/hooks/deploy-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
