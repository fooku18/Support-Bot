{
  "name": "@support-agent/workspace",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Mastra Slack application: workspaces, cross-service qualification and development commands.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "npm run generate:protocol -- --check && npm run typecheck && npm run typecheck --workspaces --if-present",
    "test:stack:up": "node scripts/test-stack.mjs up",
    "test:stack:ps": "node scripts/test-stack.mjs ps",
    "test:stack:down": "node scripts/test-stack.mjs down",
    "env:parity": "node scripts/env-parity.mjs",
    "slack:manifest": "node scripts/slack-manifest.mjs",
    "test:packages": "npm run test --workspaces --if-present",
    "generate:protocol": "node scripts/generate-protocol-clients.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:native:integration": "node tests/integration/run-native.mjs",
    "test:native:live": "node tests/live/run.mjs",
    "studio": "node scripts/studio.mjs",
    "build": "npm run build --workspaces --if-present"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,yaml,yml,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.11",
    "esbuild": "0.28.2",
    "eslint": "10.16.0",
    "eslint-config-prettier": "10.1.9",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "knip": "6.45.1",
    "lint-staged": "17.6.2",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2",
    "yaml": "2.9.1"
  },
  "license": "ISC",
  "workspaces": [
    "apps/*"
  ],
  "overrides": {
    "isolated-vm": "7.0.2"
  }
}
