# Native deployment. Copy to a private env file; never commit values.
# See docs/live-test-setup.md for each value.
COMPOSE_PROJECT_NAME=
SUPPORT_AGENT_INSTANCE=
NATIVE_IMAGE_TAG=
# Private subnets Compose creates; all three must be unused and distinct.
NATIVE_FRONTEND_SUBNET=
NATIVE_TOOLS_SUBNET=
NATIVE_DB_SUBNET=
# Optional isolated direct page fetching; all three are required together.
NATIVE_WEB_RUNTIME_URL=
WEB_RUNTIME_TOKEN=
NATIVE_WEB_NETWORK=
# Hosts the egress proxy admits from the tools network.
GITLAB_HOSTS=
ATLASSIAN_SITES=
DATADOG_SITES=
CLOUDFLARE_HOSTS=
NATIVE_RUNTIME_PASSWORD_FILE=
SUPPORT_AGENT_SERVICE_TOKEN=
ADMIN_INTERNAL_TOKEN=
CLI_RUNTIME_TOKEN=
SLACK_APP_TOKEN=
# Deployment model keys and default. List entries as one JSON array on one line.
MODEL_CATALOG=
MODEL_DEFAULT_KEY=
# Host-side secret files for active connections. Leave inactive settings empty.
NATIVE_ANTHROPIC_API_KEY_FILE=
NATIVE_OPENAI_API_KEY_FILE=
NATIVE_VERTEX_CREDENTIALS_FILE=
NATIVE_VERTEX_PROJECT=
NATIVE_VERTEX_LOCATION=
# Settings (admin) service.
ADMIN_PUBLIC_URL=
ADMIN_HOST_PORT=
ADMIN_STORE_DIR=
ADMIN_STORE_KEY=
ADMIN_SESSION_KEY=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Optional persisted telemetry: off (default) or native, with a separate secret file.
NATIVE_OBSERVABILITY_SOURCE=
NATIVE_OBSERVABILITY_PASSWORD_FILE=
