# Live-test harness sender and fixtures. Copy to <instance-dir>/.env.e2e with
# mode 0600; never commit values. Read only by tests/live/run.mjs, never by a
# service. See docs/live-test-setup.md, steps 3 and 11.
#
# Bot token (xoxb-...) of a separate Slack app, not the app under test.
# Scopes: chat:write, channels:history or groups:history, files:write, files:read.
# Its bot_id/user_id from auth.test are registered as the installation's
# test sender in the settings service. It must not appear in any other env file.
E2E_SLACK_SENDER_TOKEN=
# Workspace ID (T...) from auth.test.
E2E_SLACK_TEAM_ID=
# Test channel ID (C... or G...); equals the registered test sender channel.
E2E_SLACK_CHANNEL_ID=
#
# Gateway suite (T5) only: the GitLab test project for the coding scenarios
# ({{gitlab.*}} placeholders). The stub suite uses no tool. The host must be in
# GITLAB_HOSTS. Example values are the current fixture.
E2E_GITLAB_HOST=gitlab.com
E2E_GITLAB_PROJECT=example-group/test
E2E_GITLAB_PROJECT_ID=100001
E2E_GITLAB_TARGET_BRANCH=main
# A finished CI job of that project whose trace is longer than 48000 bytes, and
# one marker line only in its first and one only in its last 48000 bytes
# (gitlab-discovery.json).
E2E_GITLAB_TRACE_JOB_ID=900001
E2E_GITLAB_TRACE_HEAD_MARKER=trace-marker amber-falcon-3102
E2E_GITLAB_TRACE_TAIL_MARKER=trace-marker-end
#
# Settings-service API token (the API tokens page of the TEST settings
# service). Both suites need it: the stub suite's channel-settings.json changes
# the test channel's settings with it (BLOCKED without it). The driver also sets
# the channel's tool assignment to what each scenario needs (none for a stub or
# answer scenario, the ready test instance of each needed kind for a gateway
# tool or coding scenario) and restores the original afterwards. It only
# assigns and unassigns existing instances and never reads a credential.
# Without it, the channel is checked as it is: only scenarios whose tools match
# the current assignment run. It must not appear in any other env file.
E2E_ADMIN_TOKEN=
